{
  "name": "eslint-config-fluxuator",
  "version": "0.0.0-development",
  "description": "ESLint configuration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluxuator/eslint-config-fluxuator.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config"
  ],
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./a11y": "./lib/a11y.js",
    "./jest": "./lib/jest.js",
    "./node": "./lib/node.js",
    "./prettier": "./lib/prettier.js",
    "./react": "./lib/react.js",
    "./react-testing-library": "./lib/react-testing-library.js",
    "./vitest": "./lib/vitest.js"
  },
  "scripts": {
    "eslint": "eslint",
    "lint": "pnpm eslint .",
    "prettier": "prettier --ignore-unknown",
    "format:check": "pnpm prettier --check .",
    "format:fix": "pnpm prettier --write .",
    "prepare": "husky",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "test": "vitest run",
    "test:eslint": "vitest run --project ESLint",
    "test:unit": "vitest run --project UNIT",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "confusing-browser-globals": "1.0.11",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.8.0",
    "lodash.defaultsdeep": "4.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/cz-commitlint": "21.2.0",
    "@vitest/eslint-plugin": "1.6.24",
    "commitlint": "21.2.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "git-cz": "4.9.0",
    "husky": "9.1.7",
    "inquirer": "14.0.2",
    "jest": "30.4.2",
    "lint-staged": "17.3.0",
    "pinst": "3.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@vitest/eslint-plugin": "^1.6.0",
    "eslint": "^9.0.0 || ^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jest": "^29.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-testing-library": "^7.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5 || ^6",
    "typescript-eslint": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@vitest/eslint-plugin": {
      "optional": true
    },
    "eslint-config-prettier": {
      "optional": true
    },
    "eslint-plugin-jest": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-prettier": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-testing-library": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "release": {
    "tagFormat": "${version}",
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "minor"
            },
            {
              "type": "style",
              "release": "patch"
            },
            {
              "type": "chore",
              "scope": "deps",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "packageManager": "pnpm@11.18.0"
}
